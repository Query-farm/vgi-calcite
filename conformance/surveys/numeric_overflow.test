# Known failures, deliberately outside the all-passing CI gate.
# Expected values remain correct; do not encode the wrapped values as successes.

statement ok
ATTACH 'example' AS example (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

query I
SELECT SUM(CAST(9223372036854775807 AS BIGINT)) FROM example.sequence(10);
----
92233720368547758070

query I
SELECT SUM(CAST('-9223372036854775808' AS BIGINT)) FROM example.sequence(10);
----
-92233720368547758080

query R
SELECT AVG(CAST(9223372036854775807 AS BIGINT)) FROM example.sequence(10);
----
9.223372036854776E18

statement ok
DETACH example;
