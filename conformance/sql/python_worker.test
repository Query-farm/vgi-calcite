# Adapter-specific checks against the released standard Python fixture.
# These supplement the upstream cases; they are not counted as upstream coverage.

statement ok
ATTACH 'example' AS example (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

# The worker itself echoes the delivered predicate, proving remote delivery.
query ITT
SELECT n, s, pushed_filters FROM example.filter_echo(10) WHERE n = 5;
----
5	row_5	n = 5

query I
SELECT n FROM example.filter_echo(10) WHERE n >= 3 AND n < 7 ORDER BY n;
----
3
4
5
6

query I
SELECT n FROM example.filter_echo(10) WHERE n IN (1, 3, 7) ORDER BY n;
----
1
3
7

# A disjunction across columns must retain both branches.
query I
SELECT n FROM example.filter_echo(10) WHERE n = 1 OR s = 'row_8' ORDER BY n;
----
1
8

# An unsupported conjunct stays local; the compatible lower bound can travel.
query IT
SELECT n, pushed_filters FROM example.filter_echo(10) WHERE n >= 5 AND MOD(n, 2) = 0 ORDER BY n;
----
6	n >= 5
8	n >= 5

query I
SELECT COUNT(*) FROM example.filter_echo(10) WHERE s IS NULL;
----
0

# Catalog discovery also reads the worker's canonical constraint metadata.
query ITIR
SELECT id, name, quantity, price FROM example.data.products ORDER BY id;
----
1	Widget	100	9.99
2	Gadget	50	24.99
3	Doohickey	200	4.99

statement ok
DETACH example;
