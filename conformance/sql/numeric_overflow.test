# Former BIGINT overflow failures, now required to pass without decimal casts.

statement ok
ATTACH 'example' AS example (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

query I
SELECT SUM(CAST(9223372036854775807 AS BIGINT)) FROM example.sequence(10);
----
92233720368547758070

query I
SELECT SUM(CAST('-9223372036854775808' AS BIGINT)) FROM example.sequence(10);
----
-92233720368547758080

query R
SELECT AVG(CAST(9223372036854775807 AS BIGINT)) FROM example.sequence(10);
----
9.223372036854776E18

query TR
SELECT n < 5 AS low, AVG(CAST(9223372036854775807 AS BIGINT))
FROM example.sequence(10, batch_size := 3) GROUP BY n < 5 ORDER BY low;
----
false	9.223372036854776E18
true	9.223372036854776E18

query IR
SELECT SUM(DISTINCT CAST(9223372036854775807 AS BIGINT) - n),
       AVG(DISTINCT CAST(9223372036854775807 AS BIGINT) - n)
FROM example.sequence(2);
----
18446744073709551613	9.223372036854776E18

query IR
SELECT SUM(CASE WHEN n = 0 THEN NULL ELSE CAST(9223372036854775807 AS BIGINT) END),
       AVG(CASE WHEN n = 0 THEN NULL ELSE CAST(9223372036854775807 AS BIGINT) END)
FROM example.sequence(3);
----
18446744073709551614	9.223372036854776E18

query IR
SELECT SUM(CAST(9223372036854775807 AS BIGINT)) FILTER (WHERE n < 2),
       AVG(CAST(9223372036854775807 AS BIGINT)) FILTER (WHERE n < 2)
FROM example.sequence(3);
----
18446744073709551614	9.223372036854776E18

query IIR
SELECT n, SUM(CAST(9223372036854775807 AS BIGINT)) OVER w,
       AVG(CAST(9223372036854775807 AS BIGINT)) OVER w
FROM example.sequence(3, batch_size := 1)
WINDOW w AS (ORDER BY n ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) ORDER BY n;
----
0	9223372036854775807	9.223372036854776E18
1	18446744073709551614	9.223372036854776E18
2	27670116110564327421	9.223372036854776E18

statement ok
DETACH example;
